{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch DiagnosticIDE",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/DiagnosticIDE",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb",
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "windows": {
                "MIMode": "gdb",
                "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",
                "program": "${workspaceFolder}/build/src/DiagnosticIDE.exe"
            }
        },
        {
            "name": "(lldb) Launch DiagnosticIDE",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/DiagnosticIDE",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "build"
        }
    ]
}
